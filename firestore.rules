rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper: is the request from a signed-in user? ─────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    // ── Caller's numeric access level from their Firestore doc ────────────────
    //    999 = not in DB (unregistered).  Lower number = more privilege.
    //    1 = founder/director  2 = head  3 = employee  4 = client  5 = free
    function callerLevel() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.level
        : 999;
    }

    // ── Caller's role string (needed only to distinguish founder vs director) ─
    function callerRole() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'none')
        : 'none';
    }

    // ── Tier helpers ──────────────────────────────────────────────────────────
    function isDirectorOrFounder() { return isSignedIn() && callerLevel() <= 1; }
    function isFounder()           { return isSignedIn() && callerRole() == 'founder'; }
    function isEmployee()          { return isSignedIn() && callerLevel() <= 3; }
    function isRegistered()        { return isSignedIn() && callerLevel() < 999; }

    // ── Named campaign config doc (e.g. config/brics_event) ───────────────────
    //    Single source of truth for a self-registration campaign's country
    //    list, role tag, expiry window and on/off switch — read here the same
    //    way callerLevel() reads the caller's own doc, so the create rule below
    //    can validate against it without a separate read grant.
    function bricsConfig() {
      return get(/databases/$(database)/documents/config/brics_event).data;
    }

    // ── Users ─────────────────────────────────────────────────────────────────
    match /users/{userId} {

      // Any signed-in user can read their own document.
      allow get: if isSignedIn() && request.auth.uid == userId;

      // Users can update their own non-sensitive fields. Identity (role/level)
      // and commercial entitlements (plan/allowedCountries/countryQuota) are
      // admin-granted only. requestedPlan/requestedCountries/planStatus stay
      // writable so a customer can file an upgrade request themselves —
      // planStatus is additionally constrained to 'pending' below.
      allow update: if isSignedIn()
                    && request.auth.uid == userId
                    && !request.resource.data.diff(resource.data)
                         .affectedKeys().hasAny([
                           'level', 'role',
                           'plan', 'allowedCountries', 'countryQuota',
                           'planApprovedBy', 'planApprovedAt', 'planNotes'
                         ])
                    && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['planStatus'])
                        || request.resource.data.planStatus == 'pending');

      // Directors & founders: full listing + individual reads (admin console).
      // Employees (level 2–3): read-only listing for admin console.
      allow list, get: if isDirectorOrFounder();
      allow list, get: if isEmployee();

      // Self-registration on first sign-in: must create own doc at free tier only.
      // A chosen Personal/Enterprise plan may only be recorded as a *request*;
      // the granted plan and entitlements must start empty.
      allow create: if isSignedIn()
                    && request.auth.uid == userId
                    && request.resource.data.get('role',  'free') == 'free'
                    && request.resource.data.get('level', 5)      >= 5
                    && request.resource.data.get('plan',  'free') == 'free'
                    && request.resource.data.get('allowedCountries', []) == []
                    && request.resource.data.get('countryQuota', 0) == 0;

      // Campaign self-registration (e.g. BRICS 2026, brics2026.html): grants
      // the exact country list config/brics_event currently publishes, capped
      // to its expiry window, only while the campaign is active. role/plan/
      // allowedCountries/level are immutable afterwards via the update rule
      // above, so this grant can't be self-extended or the role reverted.
      allow create: if isSignedIn()
                    && request.auth.uid == userId
                    && bricsConfig().active == true
                    && request.resource.data.get('role', '')  == bricsConfig().role
                    && request.resource.data.get('level', 5)  == 5
                    && request.resource.data.get('plan', '')  == 'personal'
                    && request.resource.data.get('allowedCountries', []) == bricsConfig().allowedCountries
                    && request.resource.data.get('countryQuota', 0)      == bricsConfig().allowedCountries.size()
                    && request.resource.data.get('planExpiresAt', request.time)
                         <= request.time + duration.value(bricsConfig().expiresInDays, 'd');

      // Directors/founders can create docs for others.
      // Founders: unrestricted.  Directors: cannot create another director/founder (level ≤ 1).
      allow create: if isDirectorOrFounder()
                    && request.auth.uid != userId
                    && (isFounder() || request.resource.data.get('level', 999) > 1);

      // Directors/founders can update other users' documents.
      // Founders: unrestricted.  Directors: cannot edit directors or founders (target level ≤ 1).
      allow update: if isDirectorOrFounder()
                    && request.auth.uid != userId
                    && (isFounder() || resource.data.get('level', 999) > 1);

      // Heads (level 2) can update employees/clients/free (level 3+) — role and level only,
      // and cannot promote the target above level 3.
      allow update: if isSignedIn()
                    && callerLevel() == 2
                    && request.auth.uid != userId
                    && resource.data.get('level', 999) >= 3
                    && request.resource.data.get('level', 999) >= 3
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'level']);

      // Same authority restriction for delete.
      allow delete: if isDirectorOrFounder()
                    && request.auth.uid != userId
                    && (isFounder() || resource.data.get('level', 999) > 1);
    }

    // ── Methodology docs — employees and above can read; directors/founders write ─
    match /methodology/{docId} {
      allow read:  if isEmployee();
      allow write: if isDirectorOrFounder();
    }

    // ── Document management: Sections → Events → Files → Comments ─────────────
    //    A Section is a destination/purpose ("Barometer", "Strategic
    //    Briefs", "Client Docs", "Conference Docs", or any other
    //    director-created one). Its Firestore doc ID is a slug of its name
    //    (see admin.html's slugify()) — also used as its Storage folder
    //    name, so the bucket is human-browsable by the same name, e.g.
    //    Documents/barometer/q1-2026/GRB_Q1_2026.pdf. An Event is one
    //    instance within a section (a quarterly release, one brief). Each
    //    Event holds multiple Files — exactly one flagged `active` (the
    //    real/final one to show or share), the rest are drafts kept around
    //    for a time-crunch, pruned by a director once the event is settled.
    //    File bytes live in Firebase Storage (see storage.rules); these
    //    collections are the metadata + workflow state.
    //    level ≤ 2 = isApproverTier(): directors/founders (1) + heads (2) —
    //    the tier that approves/curates/deletes. Section creation is kept to
    //    level 1 only (a more structural action than approving one event).
    function isApproverTier() { return isSignedIn() && callerLevel() <= 2; }

    // Sections only a developer has wired a real public display for — the
    // `displayProperty` field on a section is just an organizational label,
    // not a promise that a NEW section instantly appears somewhere on the
    // site; this hardcoded list is the actual security-relevant boundary,
    // matching exactly what load-briefs.js/load-grb-reports.js/gsu-gate
    // query. These are slugs (name run through slugify()), not display
    // names — name the section exactly "Barometer" / "Strategic Briefs" so
    // it slugifies to one of these. Extend only alongside real frontend
    // work for a new section.
    function isPubliclyWiredSection(sectionId) {
      return sectionId in ['barometer', 'strategic-briefs'];
    }

    match /sections/{sectionId} {
      allow read: if isEmployee();
      allow create, update, delete: if isDirectorOrFounder();

      // Events nest under their section (sectionId is the parent path
      // segment, not a field) — this is what lets storage.rules deduce an
      // event's approval state from a Storage path alone (Documents/
      // {sectionId}/{eventId}/{fileName} maps 1:1 to this Firestore path),
      // since security rules can only do direct get()/exists() lookups, not
      // queries. Event IDs are a slug of their title (see admin.html's
      // slugify()), same reasoning as sections — human-browsable, and
      // deterministic from the Storage path.
      match /events/{eventId} {
        // Public, unauthenticated read — only in one of the two pre-wired
        // sections, approved, and visible. Needed by the marketing site
        // (load-briefs.js) and gsu-gate's unauthenticated GRB lookup.
        allow read: if isPubliclyWiredSection(sectionId)
                    && resource.data.status == 'approved'
                    && resource.data.visible == true;

        // Staff can see everything else — pending events awaiting
        // approval, and all conference/client-section events, which are
        // never public regardless of status/visible.
        allow read: if isEmployee();

        // Any staff member can create an event — but only as 'pending' and
        // invisible, attributed to themselves. Cannot self-approve.
        allow create: if isEmployee()
                      && request.resource.data.status == 'pending'
                      && request.resource.data.visible == false
                      && request.resource.data.createdBy == request.auth.uid;

        // Approve/reject/hide/show/delete — director/head only.
        allow update, delete: if isApproverTier();

        // Files are keyed by a sanitized version of their filename (not a
        // random ID), so the download always presents the real original
        // name and a same-named re-upload replaces the prior draft in
        // place — see admin.html's uploadFileToEventRaw().
        match /files/{fileId} {
          // Files are only ever listed/opened from the admin console — the
          // public site only ever reads the parent event's denormalized
          // activeFileURL, never queries this subcollection directly.
          allow read: if isEmployee();

          // Any staff member can add a draft or editable-copy file.
          allow create: if isEmployee();

          // Marking a file active, or deleting a draft, is curatorial —
          // director/head only, matching who prunes drafts after an event
          // settles.
          allow update, delete: if isApproverTier();

          match /comments/{commentId} {
            // PDF review comments — any staff can read/add; resolving or
            // deleting is the author's own call, or a director/head
            // cleaning up. Purely informal feedback — never blocks
            // approval.
            allow read: if isEmployee();
            allow create: if isEmployee()
                          && request.resource.data.authorUid == request.auth.uid;
            allow update, delete: if isEmployee()
                          && (resource.data.authorUid == request.auth.uid || isApproverTier());
          }
        }
      }
    }

    // ── Tasks ─────────────────────────────────────────────────────────────────
    match /tasks/{taskId} {
      // Directors/founders manage everything.
      allow read, write: if isDirectorOrFounder();

      // Employees can read tasks assigned to them or created by them.
      allow read: if isEmployee()
                  && (resource.data.assignedTo == request.auth.uid
                      || resource.data.createdBy == request.auth.uid);

      // Employees can update status/notes on their own assigned tasks only
      // (cannot reassign, change creator, or alter priority).
      allow update: if isEmployee()
                    && resource.data.assignedTo == request.auth.uid
                    && !request.resource.data.diff(resource.data)
                         .affectedKeys().hasAny(['assignedTo', 'createdBy', 'priority']);
    }

    // ── App config — any registered user can read; directors/founders write ───
    match /config/{docId} {
      // config/brics_event must be readable pre-signup (the registration page
      // checks whether the campaign is still active before showing its form)
      // and mid-signup (the caller isn't "registered" yet at that exact
      // moment) — carved out as public-read. Every other config doc keeps the
      // registered-only default.
      allow read:  if docId == 'brics_event' || isRegistered();
      allow write: if isDirectorOrFounder();
    }

    // ── Deny everything else by default ──────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
