rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Mirrors firestore.rules' caller-level helpers via the documented
    // cross-service firestore.get()/firestore.exists() calls — Storage rules
    // have no concept of a "user doc" on their own, so this is how a
    // Storage rule learns the caller's level/role from their Firestore
    // users/{uid} record.
    function isSignedIn() { return request.auth != null; }
    function callerLevel() {
      return isSignedIn() && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        ? firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.level
        : 999;
    }
    function isApproverTier() { return isSignedIn() && callerLevel() <= 2; } // directors + heads
    function isEmployee()     { return isSignedIn() && callerLevel() <= 3; } // any staff

    // File bytes live at Documents/{sectionId}/{eventId}/{fileName} — named
    // the same as the matching Firestore sections/{sectionId}/events/{eventId}
    // path, so a Storage rule can directly look up that event's own
    // approval state via a cross-service read (no listing/query needed,
    // since security rules can only do direct get()/exists() by path).
    // {sectionId}/{eventId} are slugs of the section/event names (see
    // admin.html's slugify()); {fileName} is the real original filename —
    // a same-named re-upload simply replaces the prior draft's bytes.
    match /Documents/{sectionId}/{eventId}/{fileName} {
      function parentEvent() {
        return firestore.get(/databases/(default)/documents/sections/$(sectionId)/events/$(eventId)).data;
      }
      allow read: if isEmployee()
                  || (sectionId in ['barometer', 'strategic-briefs']
                      && parentEvent().status == 'approved'
                      && parentEvent().visible == true);
      allow create: if isEmployee();
      allow delete: if isApproverTier();
    }

    // Deny everything else by default.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
