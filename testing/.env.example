# Copy this file to .env and fill in real values. .env is gitignored — never
# commit it. See testing/README.md for which kind of account to use here.

# A dedicated, low-privilege gsu-members test account (email-verified).
# Do NOT use a real teammate's personal account or a director/founder account.
TEST_ACCOUNT_EMAIL=
TEST_ACCOUNT_PASSWORD=

# Where the site is served from while testing. Defaults to a local static
# server (python -m http.server 8000) — change only if you really mean to
# point this at a deployed environment.
BASE_URL=http://localhost:8000
